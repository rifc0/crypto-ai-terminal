import React, { useMemo, useState } from 'react';
import {
  Upload,
  TrendingUp,
  TrendingDown,
  Shield,
  Target,
  Activity,
  BarChart3,
  BrainCircuit,
  CandlestickChart,
  Layers3,
  Zap,
  ScanSearch
} from 'lucide-react';

const indicators = [
  'RSI (14)',
  'MACD',
  'EMA 50',
  'EMA 200',
  'VWAP',
  'Volume Profile'
];

function generateSignal() {
  const bullish = Math.random() > 0.5;
  const confidence = Math.floor(Math.random() * 14) + 82;

  const entry = bullish ? 68420 : 68420;

  const stop = bullish ? 67890 : 68980;

  const tp1 = bullish ? 69120 : 67800;
  const tp2 = bullish ? 69850 : 67200;
  const tp3 = bullish ? 70500 : 66500;

  const slPercent = bullish ? '-0.77%' : '+0.81%';

  return {
    signal: bullish ? 'LONG' : 'SHORT',
    confidence,
    entry,
    stop,
    tp1,
    tp2,
    tp3,
    slPercent,
    tp1Percent: bullish ? '+1.02%' : '-0.91%',
    tp2Percent: bullish ? '+2.08%' : '-1.78%',
    tp3Percent: bullish ? '+3.04%' : '-2.80%',
    trend: bullish ? 'Бычий импульс' : 'Медвежий импульс',
    risk: bullish ? 'LOW RISK' : 'MEDIUM RISK',
    volume: bullish ? 'HIGH BUY VOLUME' : 'HIGH SELL VOLUME',
    structure: bullish ? 'BOS CONFIRMED' : 'BEARISH BREAKDOWN'
  };
}

export default function CryptoAiTerminal() {
  const [image, setImage] = useState(null);
  const [preview, setPreview] = useState('');
  const [loading, setLoading] = useState(false);
  const [analysis, setAnalysis] = useState(null);
  const [timeframe, setTimeframe] = useState('1H');

  const canAnalyze = useMemo(() => Boolean(image && !loading), [image, loading]);

  const handleUpload = (e) => {
    const file = e.target.files?.[0];
    if (!file) return;

    setImage(file);
    setPreview(URL.createObjectURL(file));
    setAnalysis(null);
  };

  const startAnalysis = async () => {
    if (!image) return;

    setLoading(true);

    await new Promise((resolve) => setTimeout(resolve, 3000));

    setAnalysis(generateSignal());

    setLoading(false);
  };

  return (
    <div className="min-h-screen bg-black text-white overflow-hidden relative">
      {/* base glow */}
      <div className="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(255,255,255,0.09),transparent_35%)]" />

      {/* soft moving shimmer layer */}
      <div className="absolute inset-0 opacity-30 animate-pulse bg-[radial-gradient(circle_at_20%_30%,rgba(255,255,255,0.10),transparent_40%),radial-gradient(circle_at_80%_70%,rgba(255,255,255,0.08),transparent_45%)]" />

      {/* big ambient blobs */}
      <div className="absolute top-0 left-1/4 w-[700px] h-[700px] bg-white/5 blur-3xl rounded-full animate-pulse" />
      <div className="absolute bottom-0 right-1/4 w-[500px] h-[500px] bg-zinc-500/10 blur-3xl rounded-full animate-pulse" />

      <div className="relative z-10 max-w-7xl mx-auto p-6">
        <header className="mb-10">
          <div className="flex flex-wrap items-center justify-between gap-4 mb-8">
            <div className="flex items-center gap-4">
              <div className="w-20 h-20 rounded-[28px] bg-white text-black flex items-center justify-center shadow-[0_0_50px_rgba(255,255,255,0.2)]">
                <BrainCircuit className="w-10 h-10" />
              </div>

              <div>
                <h1 className="text-6xl font-black tracking-tight bg-gradient-to-r from-white to-zinc-500 text-transparent bg-clip-text">
                  CRYPTO AI TERMINAL
                </h1>

                <p className="text-zinc-500 text-lg mt-2 tracking-wide">
                  Institutional Smart Money Analyzer
                </p>
              </div>
            </div>

            <div className="px-6 py-4 rounded-3xl bg-white/[0.04] border border-white/10 backdrop-blur-xl">
              <div className="flex items-center gap-3">
                <div className="w-3 h-3 rounded-full bg-green-400 animate-pulse" />

                <span className="font-semibold text-zinc-200">
                  AI ENGINE ONLINE
                </span>
              </div>
            </div>
          </div>

          <div className="grid grid-cols-1 md:grid-cols-4 gap-4">
            {['15M', '1H', '4H', '1D'].map((tf) => (
              <button
                key={tf}
                onClick={() => setTimeframe(tf)}
                className={`rounded-3xl py-5 text-xl font-bold transition-all ${
                  timeframe === tf
                    ? 'bg-white text-black scale-[1.03] shadow-[0_0_40px_rgba(255,255,255,0.25)]'
                    : 'bg-white/[0.04] border border-white/10 text-zinc-400 hover:bg-white/[0.07] hover:text-white'
                }`}
              >
                {tf}
              </button>
            ))}
          </div>
        </header>

        <div className="grid grid-cols-1 xl:grid-cols-2 gap-8">
          <div className="rounded-[36px] border border-white/10 bg-white/[0.03] backdrop-blur-2xl p-6 shadow-[0_0_80px_rgba(255,255,255,0.05)] relative overflow-hidden">
            <div className="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(255,255,255,0.08),transparent_35%)]" />

            <div className="relative z-10">
              <div className="flex items-center justify-between mb-8">
                <div>
                  <h2 className="text-4xl font-black mb-2">
                    Настрой TradingView
                  </h2>

                  <p className="text-zinc-500">
                    Добавь эти индикаторы перед загрузкой
                  </p>
                </div>

                <div className="px-5 py-3 rounded-2xl bg-white text-black font-black shadow-[0_0_30px_rgba(255,255,255,0.25)]">
                  PRO AI
                </div>
              </div>

              <div className="grid grid-cols-2 gap-4 mb-8">
                {indicators.map((item) => (
                  <div
                    key={item}
                    className="rounded-3xl bg-white/[0.04] border border-white/10 p-5 backdrop-blur-xl hover:bg-white/[0.06] transition-all"
                  >
                    <div className="flex items-center justify-between">
                      <span className="font-semibold text-lg">
                        {item}
                      </span>

                      <div className="w-3 h-3 rounded-full bg-white" />
                    </div>
                  </div>
                ))}
              </div>

              <label className="h-[420px] rounded-[36px] border border-white/10 bg-black/30 flex items-center justify-center overflow-hidden cursor-pointer hover:border-white/20 transition-all group">
                {preview ? (
                  <img
                    src={preview}
                    alt="chart"
                    className="w-full h-full object-cover"
                  />
                ) : (
                  <div className="text-center px-6">
                    <div className="w-28 h-28 rounded-full bg-white text-black flex items-center justify-center mx-auto mb-8 shadow-[0_0_40px_rgba(255,255,255,0.2)] group-hover:scale-105 transition-all">
                      <Upload className="w-14 h-14" />
                    </div>

                    <h3 className="text-4xl font-black mb-4">
                      ЗАГРУЗИ ГРАФИК
                    </h3>

                    <p className="text-zinc-500 text-lg leading-relaxed max-w-md mx-auto">
                      AI проанализирует Smart Money структуру, импульсы, ликвидность и даст торговый сетап.
                    </p>
                  </div>
                )}

                <input
                  type="file"
                  accept="image/*"
                  className="hidden"
                  onChange={handleUpload}
                />
              </label>

              <button
                onClick={startAnalysis}
                disabled={!canAnalyze}
                className="mt-8 w-full py-6 rounded-[28px] bg-white text-black text-2xl font-black transition-all hover:scale-[1.01] hover:shadow-[0_0_60px_rgba(255,255,255,0.25)] disabled:opacity-40 flex items-center justify-center gap-4"
              >
                {loading ? (
                  <>
                    <ScanSearch className="w-8 h-8 animate-pulse" />
                    AI АНАЛИЗИРУЕТ РЫНОК...
                  </>
                ) : (
                  <>
                    <Zap className="w-8 h-8" />
                    ЗАПУСТИТЬ AI АНАЛИЗ
                  </>
                )}
              </button>
            </div>
          </div>

          <div className="rounded-[36px] border border-white/10 bg-white/[0.03] backdrop-blur-2xl p-6 shadow-[0_0_80px_rgba(255,255,255,0.05)]">
            {!analysis ? (
              <div className="h-full min-h-[900px] flex items-center justify-center text-center">
                <div>
                  <div className="w-32 h-32 rounded-full bg-white/[0.04] border border-white/10 flex items-center justify-center mx-auto mb-8">
                    <CandlestickChart className="w-16 h-16 text-zinc-500" />
                  </div>

                  <h2 className="text-5xl font-black mb-4">
                    AI ГОТОВ К АНАЛИЗУ
                  </h2>

                  <p className="text-zinc-500 text-xl max-w-lg leading-relaxed">
                    Загрузи график с TradingView для получения полного Smart Money анализа.
                  </p>
                </div>
              </div>
            ) : (
              <div>
                <div className={`rounded-[36px] p-8 border mb-8 ${
                  analysis.signal === 'LONG'
                    ? 'bg-green-500/10 border-green-500/30'
                    : 'bg-red-500/10 border-red-500/30'
                }`}>
                  <div className="flex items-center justify-between mb-6">
                    <div className="flex items-center gap-5">
                      <div className={`w-24 h-24 rounded-[28px] flex items-center justify-center ${
                        analysis.signal === 'LONG'
                          ? 'bg-green-500/20'
                          : 'bg-red-500/20'
                      }`}>
                        {analysis.signal === 'LONG' ? (
                          <TrendingUp className="w-14 h-14 text-green-400" />
                        ) : (
                          <TrendingDown className="w-14 h-14 text-red-400" />
                        )}
                      </div>

                      <div>
                        <h2 className="text-7xl font-black tracking-tight">
                          {analysis.signal}
                        </h2>

                        <p className="text-2xl text-zinc-300 mt-2">
                          {analysis.trend}
                        </p>
                      </div>
                    </div>

                    <div className="text-right">
                      <p className="text-zinc-400 text-lg mb-2">
                        AI CONFIDENCE
                      </p>

                      <h3 className="text-6xl font-black">
                        {analysis.confidence}%
                      </h3>
                    </div>
                  </div>

                  <div className="grid grid-cols-3 gap-4">
                    <div className="rounded-3xl bg-black/20 border border-white/10 p-5">
                      <p className="text-zinc-500 mb-2">Risk</p>
                      <h3 className="text-2xl font-bold">{analysis.risk}</h3>
                    </div>

                    <div className="rounded-3xl bg-black/20 border border-white/10 p-5">
                      <p className="text-zinc-500 mb-2">Volume</p>
                      <h3 className="text-2xl font-bold">{analysis.volume}</h3>
                    </div>

                    <div className="rounded-3xl bg-black/20 border border-white/10 p-5">
                      <p className="text-zinc-500 mb-2">Structure</p>
                      <h3 className="text-2xl font-bold">{analysis.structure}</h3>
                    </div>
                  </div>
                </div>

                <div className="grid grid-cols-2 gap-5 mb-8">
                  <div className="rounded-[32px] bg-white/[0.04] border border-white/10 p-6">
                    <div className="flex items-center gap-3 mb-5">
                      <Shield className="w-8 h-8" />
                      <h3 className="text-3xl font-black">STOP LOSS</h3>
                    </div>

                    <p className="text-5xl font-black mb-3">
                      {analysis.slPercent}
                    </p>

                    <p className="text-zinc-500 text-lg">
                      {analysis.stop} USDT
                    </p>
                  </div>

                  <div className="rounded-[32px] bg-white/[0.04] border border-white/10 p-6">
                    <div className="flex items-center gap-3 mb-5">
                      <Target className="w-8 h-8" />
                      <h3 className="text-3xl font-black">TAKE PROFIT</h3>
                    </div>

                    <p className="text-5xl font-black mb-3">
                      {analysis.tp3Percent}
                    </p>

                    <p className="text-zinc-500 text-lg">
                      {analysis.tp3} USDT
                    </p>
                  </div>
                </div>

                <div className="rounded-[36px] bg-white/[0.03] border border-white/10 p-6 mb-8">
                  <div className="flex items-center gap-3 mb-6">
                    <Layers3 className="w-8 h-8" />
                    <h3 className="text-4xl font-black">AI TARGETS</h3>
                  </div>

                  <div className="space-y-4">
                    {[
                      ['TP1', analysis.tp1, analysis.tp1Percent],
                      ['TP2', analysis.tp2, analysis.tp2Percent],
                      ['TP3', analysis.tp3, analysis.tp3Percent]
                    ].map(([label, price, percent]) => (
                      <div
                        key={label}
                        className="rounded-3xl bg-white/[0.04] border border-white/10 p-5 flex items-center justify-between"
                      >
                        <div>
                          <p className="text-zinc-500 mb-1">{label}</p>
                          <h4 className="text-3xl font-black">
                            {price} USDT
                          </h4>
                        </div>

                        <div className="text-4xl font-black text-green-400">
                          {percent}
                        </div>
                      </div>
                    ))}
                  </div>
                </div>

                <div className="rounded-[36px] bg-white/[0.03] border border-white/10 p-6">
                  <div className="flex items-center gap-3 mb-6">
                    <Activity className="w-8 h-8" />
                    <h3 className="text-4xl font-black">AI SUMMARY</h3>
                  </div>

                  <div className="space-y-4 text-zinc-300 text-lg leading-relaxed">
                    <p>
                      AI обнаружил подтвержденную рыночную структуру и сильный импульс.
                    </p>

                    <p>
                      Индикаторы показывают синхронное подтверждение направления.
                    </p>

                    <p>
                      Объемы поддерживают текущее движение и вероятность продолжения.
                    </p>

                    <p>
                      Рекомендуется вход только после закрытия подтверждающей свечи.
                    </p>
                  </div>
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  );
}
